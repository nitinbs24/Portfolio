server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.com www.yourdomain.com; # Replace with your domain

    # Root directory for the static Next.js export
    root /var/www/portfolio/out; # Replace with the actual path on your VPS
    index index.html;

    # Gzip compression for faster loading
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Location blocks
    location / {
        # Try to serve the requested file, then try adding .html (for Next.js dynamic routes if any), then fall back to index.html (useful for client-side routing)
        try_files $uri $uri.html $uri/ /index.html;
    }

    # Optional: Cache static assets (fonts, images, etc.)
    location ~* \.(?:css|js|jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc|woff2?|eot|ttf|otf)$ {
        expires 1M;
        access_log off;
        add_header Cache-Control "public";
    }

    # Deny access to hidden files (.git, .env, etc.)
    location ~ /\. {
        deny all;
    }
}
